# Environment Variables for FOLSME Backend

# Server Configuration
PORT=3000
NODE_ENV=production

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Paystack Configuration (for live payments)
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# CORS Configuration (add your domains)
ALLOWED_ORIGINS=https://folsmeinternationallimited.netlify.app,https://folsmeinternational.com,https://www.folsmeinternational.com

# Database Configuration (if using external database)
# DATABASE_URL=your-database-connection-string